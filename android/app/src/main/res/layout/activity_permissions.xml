<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            style="@style/Widget.Playground.Toolbar" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F2F2F7"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Camera"
                android:textSize="13sp"
                android:textColor="#6D6D72"
                android:textAllCaps="true"
                android:paddingTop="24dp"
                android:paddingBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/camera_permission_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="17sp"
                        android:textColor="#000000"
                        android:paddingBottom="16dp"
                        android:contentDescription="camera_permission_status" />

                    <Button
                        android:id="@+id/request_camera_permission_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Request Camera Permission"
                        android:contentDescription="request_camera_permission_button" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Location"
                android:textSize="13sp"
                android:textColor="#6D6D72"
                android:textAllCaps="true"
                android:paddingTop="24dp"
                android:paddingBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/location_permission_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="17sp"
                        android:textColor="#000000"
                        android:paddingBottom="16dp"
                        android:contentDescription="location_permission_status" />

                    <Button
                        android:id="@+id/request_location_permission_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Request Location Permission"
                        android:contentDescription="request_location_permission_button" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Notifications"
                android:textSize="13sp"
                android:textColor="#6D6D72"
                android:textAllCaps="true"
                android:paddingTop="24dp"
                android:paddingBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/notifications_permission_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="17sp"
                        android:textColor="#000000"
                        android:paddingBottom="16dp"
                        android:contentDescription="notifications_permission_status" />

                    <Button
                        android:id="@+id/request_notifications_permission_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Request Notifications Permission"
                        android:contentDescription="request_notifications_permission_button" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Alerts"
                android:textSize="13sp"
                android:textColor="#6D6D72"
                android:textAllCaps="true"
                android:paddingTop="24dp"
                android:paddingBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/alert_result"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="17sp"
                        android:textColor="#000000"
                        android:paddingBottom="16dp"
                        android:contentDescription="alert_result" />

                    <Button
                        android:id="@+id/show_simple_alert_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Show Simple Alert"
                        android:contentDescription="show_simple_alert_button" />

                    <Button
                        android:id="@+id/show_confirm_alert_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Show Confirm Alert"
                        android:contentDescription="show_confirm_alert_button" />

                    <Button
                        android:id="@+id/show_three_button_alert_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Show Three Button Alert"
                        android:contentDescription="show_three_button_alert_button" />

                    <Button
                        android:id="@+id/show_prompt_alert_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Show Prompt Alert"
                        android:contentDescription="show_prompt_alert_button" />

                    <Button
                        android:id="@+id/show_delayed_alert_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Show Alert in 2 Seconds"
                        android:contentDescription="show_delayed_alert_button" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
